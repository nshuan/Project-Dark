      Data: 53|Dark.Tools.Language.Runtime.LanguageItem, Assembly-CSharp
    - Name: languageMap
      Entry: 7
      Data: 54|System.Collections.Generic.Dictionary`2[[Dark.Tools.Language.LanguageType,
        Assembly-CSharp],[System.String, mscorlib]], mscorlib
    - Name: comparer
      Entry: 9
