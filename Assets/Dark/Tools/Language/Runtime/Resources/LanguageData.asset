      Data: 613|Dark.Tools.Language.Runtime.LanguageItem, Assembly-CSharp
    - Name: languageMap
      Entry: 7
      Data: 614|System.Collections.Generic.Dictionary`2[[Dark.Tools.Language.LanguageType,
        Assembly-CSharp],[System.String, mscorlib]], mscorlib
    - Name: comparer
      Entry: 9
